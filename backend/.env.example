# =====================================================================
# Clause backend settings
# Copy this file to .env and change what you need:   cp .env.example .env
# Every value below is optional; the defaults are shown.
# Real environment variables override this file (useful in Docker/CI).
# Never commit .env (it is in .gitignore). Secrets are never logged or
# returned by the API.
# =====================================================================

# ---------- App ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Where the database, uploaded files, vector index and eval reports live
DATA_DIR=./data
# Leave empty for SQLite in DATA_DIR. Postgres later:
# DATABASE_URL=postgresql+psycopg://clause:password@localhost:5432/clause   (and: uv add "psycopg[binary]")
DATABASE_URL=
MAX_UPLOAD_MB=25

# ---------- Chat model (LangChain init_chat_model) ----------
# Local and free with Ollama:  ollama pull gemma3:4b
CHAT_PROVIDER=ollama
CHAT_MODEL=gemma3:1b
CHAT_TEMPERATURE=0.1
CHAT_BASE_URL=gemini-3.5-flash-lite
CHAT_API_KEY=
CHAT_API_KEY=
# Other providers (install the package first):
#   uv add langchain-anthropic   -> CHAT_PROVIDER=anthropic  CHAT_MODEL=<model id>  CHAT_API_KEY=sk-ant-...
#   uv add langchain-openai      -> CHAT_PROVIDER=openai     CHAT_MODEL=<model id>  CHAT_API_KEY=sk-...
#   uv add langchain-google-genai -> CHAT_PROVIDER=google_genai CHAT_MODEL=<model id> CHAT_API_KEY=...
# Offline test mode (no model at all, extractive answers): CHAT_PROVIDER=fake

# ---------- Embeddings (LangChain init_embeddings) ----------
# Local with Ollama:  ollama pull nomic-embed-text
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=64
# Changing the embedding model is safe: Clause notices and re-embeds every chunk at the next start.
# Offline test mode: EMBEDDING_PROVIDER=fake

# ---------- Evaluation judge (LLM-as-judge) ----------
# Empty = use the chat model. A stronger judge gives more trustworthy scores.
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=

# ---------- Indexing ----------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
# Embed "file > section" together with each chunk (contextual chunk headers)
CONTEXTUAL_HEADERS=true

# ---------- Pre-retrieval ----------
# Rewrite follow-up questions into standalone questions using the chat history
QUERY_REWRITE=true
# Split complex questions into sub-queries (one extra model call per question)
QUERY_EXPANSION=false
MAX_SUB_QUERIES=3

# ---------- Retrieval ----------
# hybrid = vectors + BM25 keywords fused with Reciprocal Rank Fusion
RETRIEVAL_MODE=hybrid
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
RRF_K=60
VECTOR_WEIGHT=1.0
KEYWORD_WEIGHT=1.0
# Outlier exclusion for vector hits (cosine similarity)
MIN_VECTOR_SCORE=0.10
VECTOR_SCORE_GAP=0.50

# ---------- Post-retrieval ----------
# flashrank (cross-encoder, downloads ~30 MB once) | llm | lexical | none
RERANKER=flashrank
FLASHRANK_MODEL=ms-marco-MiniLM-L-12-v2
RERANK_CANDIDATES=30
RERANK_TOP_N=5
# Optional: drop passages whose rerank score is below this (0-1)
# MIN_RERANK_SCORE=0.05
MAX_CONTEXT_CHARS=12000
# true = answer only from documents; false = may add general knowledge, clearly marked
STRICT_SOURCES=true
HISTORY_TURNS=4
